# ==========================================
# Shelved Environment Variables
# NEVER commit your real secrets (.env) to version control!
# ==========================================

# Required: Steam Web API Key (Get from https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=your_steam_api_key_here

# Optional: Vercel Analytics REST API Integration (for /api/visitors)
# Generate a read-only token from Vercel Account Settings -> Tokens
VERCEL_AUTH_TOKEN=your_vercel_read_token_here
VERCEL_PROJECT_ID=your_vercel_project_id_here
VERCEL_TEAM_ID=your_vercel_team_id_here

# Optional: Custom Base URL for Steam OpenID authentication redirects
# Defaults to https://${VERCEL_URL} in production or http://localhost:3000 in dev
NEXT_PUBLIC_BASE_URL=https://your-domain.com
